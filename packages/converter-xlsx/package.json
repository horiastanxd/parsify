{
  "name": "@parsify/converter-xlsx",
  "version": "0.1.0",
  "description": "XLSX converter for Parsify (exceljs). Each sheet becomes a table. Lazy-loaded.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@parsify/core": "workspace:*"
  },
  "peerDependencies": {
    "exceljs": ">=4"
  },
  "devDependencies": {
    "exceljs": "^4.4.0"
  },
  "keywords": ["xlsx", "excel", "markdown", "parsify"],
  "repository": {
    "type": "git",
    "url": "https://github.com/parsify/parsify"
  },
  "publishConfig": {
    "access": "public"
  }
}
