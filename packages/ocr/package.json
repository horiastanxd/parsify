{
  "name": "@parsify/ocr",
  "version": "0.1.0",
  "description": "Optional local OCR for Parsify (tesseract.js). Zero-cloud image-to-text. Lazy-loaded.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@parsify/core": "workspace:*"
  },
  "peerDependencies": {
    "tesseract.js": ">=5"
  },
  "devDependencies": {
    "tesseract.js": "^5.1.1"
  },
  "keywords": ["ocr", "tesseract", "image", "markdown", "parsify"],
  "repository": {
    "type": "git",
    "url": "https://github.com/parsify/parsify"
  },
  "publishConfig": {
    "access": "public"
  }
}
